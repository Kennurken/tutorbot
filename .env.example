# ---- Telegram ---------------------------------------------------------------
# Token from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=123456:replace-me
# webhook (production) | polling (local development, no public URL needed)
TELEGRAM_MODE=polling
# Public HTTPS URL of this service. Used only in webhook mode; on Render it defaults to RENDER_EXTERNAL_URL.
TELEGRAM_WEBHOOK_URL=https://your-service.onrender.com
# Random string; Telegram echoes it back in the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=change-me-random-string
# Optional allowlist of Telegram user ids (comma separated). Empty = everyone may use the bot.
TELEGRAM_ALLOWED_USER_IDS=

# ---- Database ---------------------------------------------------------------
# Local:    jdbc:postgresql://localhost:5432/tutorbot
# Supabase: use the *session pooler* URI (port 5432, IPv4), see docs/DEPLOYMENT.md
DATABASE_URL=jdbc:postgresql://localhost:5432/tutorbot
DATABASE_USERNAME=tutorbot
DATABASE_PASSWORD=tutorbot

# ---- AI (any OpenAI-compatible chat-completions API) -------------------------
# fake = deterministic canned answers (no network). gateway = real model calls.
AI_PROVIDER=gateway
# Option A (free, no card): Groq — https://console.groq.com
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=replace-me
AI_MODEL=openai/gpt-oss-120b
AI_FALLBACK_MODEL=openai/gpt-oss-20b
# gpt-oss is a reasoning model: keep its thinking short so the JSON fits the token budget
AI_REASONING_EFFORT=low
AI_PRICE_INPUT_PER_MILLION=0.15
AI_PRICE_OUTPUT_PER_MILLION=0.60
# Option B: Vercel AI Gateway (needs a card on file for free credits) — Grok:
# AI_BASE_URL=https://ai-gateway.vercel.sh/v1
# AI_MODEL=spacexai/grok-4.1-fast-non-reasoning
# AI_FALLBACK_MODEL=poolside/laguna-s-2.1-free

# ---- Scheduler --------------------------------------------------------------
# Shared secret for the external cron ping (X-Tick-Secret header).
TICK_SECRET=change-me-too

# ---- App --------------------------------------------------------------------
APP_DEFAULT_TIMEZONE=Asia/Almaty
